{
  "name": "cursor-share-image-mirror",
  "displayName": "Cursor Share Trim",
  "description": "分享超限时裁到服务器还能接受的长度，并可以按当前会话重新生成链接。",
  "version": "0.0.8",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:shareImageMirror.trimAndShare",
    "onView:shareImageMirror.panel"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": true,
      "description": "只在本机写入分享开关，不读取工作区文件。"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "shareImageMirror.trimAndShare",
        "title": "Trim conversation to the share limit and share",
        "category": "Share Trim"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shareImageMirror",
          "title": "分享裁剪",
          "icon": "media/panel.svg"
        }
      ]
    },
    "views": {
      "shareImageMirror": [
        {
          "type": "webview",
          "id": "shareImageMirror.panel",
          "name": "操作"
        }
      ]
    },
    "configuration": {
      "title": "Share Trim",
      "properties": {
        "shareImageMirror.trimEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "分享超限时，自动留下服务器还能接受的最近一段。关闭后整段原样发送。"
        },
        "shareImageMirror.regenerateLink": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "已有分享时，按当前会话重新生成链接并删除旧链接。关闭后再次分享仍打开上次的链接。"
        },
        "shareImageMirror.minAttempts": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "到这个轮数以后，只要成功过一次，就留下其中最长的一段并停止。设成 1 时，第一次成功就停。"
        },
        "shareImageMirror.maxAttempts": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "到这个轮数就停。一次都没成功也停。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "node test/shareTrim.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.9.2"
  }
}
